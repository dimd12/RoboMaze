<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="650.0"
            prefWidth="900.0"
            style="-fx-background-color: #000000;"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.robomaze.controllers.PrimaryController">

   <left>
      <VBox alignment="CENTER"
            prefHeight="650.0"
            prefWidth="303.0"
            spacing="20.0"
            style="-fx-background-color: #151515; -fx-background-radius: 18; -fx-border-color: #777777; -fx-border-width: 2; -fx-border-radius: 18; -fx-padding: 20;"
            BorderPane.alignment="CENTER">
         <children>

            <VBox alignment="CENTER"
                  prefHeight="108.0"
                  prefWidth="303.0">
               <children>
                  <Label prefHeight="57.0"
                         prefWidth="133.0"
                         text="ROBOT"
                         style="-fx-text-fill: white;">
                     <font>
                        <Font name="System Bold Italic" size="40.0"/>
                     </font>
                  </Label>

                  <Label prefHeight="52.0"
                         prefWidth="102.0"
                         text="MAZE"
                         style="-fx-text-fill: white;">
                     <font>
                        <Font name="System Bold Italic" size="36.0"/>
                     </font>
                  </Label>
               </children>
            </VBox>

            <Button fx:id="playButton"
                    mnemonicParsing="false"
                    onAction="#switchToSecondary"
                    prefHeight="42.0"
                    prefWidth="194.0"
                    text="Play"
                    style="-fx-background-color: #292929; -fx-text-fill: white; -fx-background-radius: 12; -fx-border-color: #888888; -fx-border-width: 1.5; -fx-border-radius: 12; -fx-cursor: hand;"/>

            <Button mnemonicParsing="false"
                    prefHeight="42.0"
                    prefWidth="194.0"
                    text="How to Play"
                    style="-fx-background-color: #292929; -fx-text-fill: white; -fx-background-radius: 12; -fx-border-color: #888888; -fx-border-width: 1.5; -fx-border-radius: 12; -fx-cursor: hand;"/>

            <Button mnemonicParsing="false"
                    prefHeight="42.0"
                    prefWidth="194.0"
                    text="Quit"
                    style="-fx-background-color: #292929; -fx-text-fill: white; -fx-background-radius: 12; -fx-border-color: #888888; -fx-border-width: 1.5; -fx-border-radius: 12; -fx-cursor: hand;"/>

         </children>
      </VBox>
   </left>

   <center>
      <ImageView fitHeight="652.0"
                 fitWidth="598.0"
                 pickOnBounds="true"
                 preserveRatio="true"
                 BorderPane.alignment="CENTER"/>
   </center>

</BorderPane>
