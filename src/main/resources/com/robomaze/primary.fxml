<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>


<BorderPane prefHeight="650.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.robomaze.controllers.PrimaryController">
   <left>
      <VBox alignment="CENTER" prefHeight="650.0" prefWidth="303.0" spacing="20.0" BorderPane.alignment="CENTER">
         <children>
            <VBox alignment="CENTER" prefHeight="108.0" prefWidth="303.0">
               <children>
                  <Label prefHeight="57.0" prefWidth="133.0" text="ROBOT">
                     <font>
                        <Font name="System Bold Italic" size="40.0" />
                     </font>
                  </Label>
                  <Label prefHeight="52.0" prefWidth="102.0" text="MAZE">
                     <font>
                        <Font name="System Bold Italic" size="36.0" />
                     </font>
                  </Label>
               </children>
            </VBox>
            <Button mnemonicParsing="false" prefHeight="36.0" prefWidth="194.0" text="Play" fx:id="playButton" onAction="#switchToSecondary" />
            <Button mnemonicParsing="false" prefHeight="35.0" prefWidth="188.0" text="How to Play" />
            <Button mnemonicParsing="false" prefHeight="35.0" prefWidth="184.0" text="Quit" />
         </children>
      </VBox>
   </left>
   <center>
      <ImageView fitHeight="652.0" fitWidth="598.0" pickOnBounds="true" preserveRatio="true" BorderPane.alignment="CENTER" />
   </center>
</BorderPane>
