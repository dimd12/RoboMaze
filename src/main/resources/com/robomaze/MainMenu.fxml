<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="650.0"
            prefWidth="900.0"
            style="-fx-background-color: #070B12;"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.robomaze.controllers.MenuController">

    <left>
        <VBox alignment="CENTER"
              prefHeight="650.0"
              prefWidth="303.0"
              spacing="20.0"
              style="-fx-background-color: #111720;
                     -fx-background-radius: 18;
                     -fx-border-color: #343D49;
                     -fx-border-width: 2;
                     -fx-border-radius: 18;
                     -fx-padding: 20;"
              BorderPane.alignment="CENTER">
            <children>
                <VBox alignment="CENTER"
                      prefHeight="108.0"
                      prefWidth="303.0">
                    <children>
                        <Label prefHeight="72.0"
                               prefWidth="160.0"
                               style="-fx-text-fill: #E6EAF0;"
                               text="ROBOT">
                            <font>
                                <Font name="DejaVu Sans Mono Bold" size="50.0" />
                            </font>
                        </Label>

                        <Label prefHeight="72.0"
                               prefWidth="130.0"
                               style="-fx-text-fill: #E6EAF0;"
                               text="MAZE">
                            <font>
                                <Font name="DejaVu Sans Mono Bold" size="50.0" />
                            </font>
                        </Label>
                    </children>
                </VBox>

                <Button fx:id="btnPlay"
                        mnemonicParsing="false"
                        onAction="#switchToGame"
                        prefHeight="42.0"
                        prefWidth="194.0"
                        style="-fx-background-color: #E6EAF0;
                               -fx-text-fill: #1B222D;
                               -fx-background-radius: 12;
                               -fx-border-color: #343D49;
                               -fx-border-width: 1.5;
                               -fx-border-radius: 12;
                               -fx-cursor: hand;"
                        text="PLAY">
                    <font>
                        <Font name="DejaVu Sans Mono Bold" size="20.0" />
                    </font>
                </Button>

                <Button fx:id="btnHTP"
                        mnemonicParsing="false"
                        prefHeight="42.0"
                        prefWidth="194.0"
                        style="-fx-background-color: #1B222D;
                               -fx-text-fill: #E6EAF0;
                               -fx-background-radius: 12;
                               -fx-border-color: #343D49;
                               -fx-border-width: 1.5;
                               -fx-border-radius: 12;
                               -fx-cursor: hand;"
                        text="How to Play">
                    <font>
                        <Font name="DejaVu Sans Mono Bold" size="20.0" />
                    </font>
                </Button>

                <Button fx:id="btnQuit"
                        mnemonicParsing="false"
                        prefHeight="42.0"
                        prefWidth="194.0"
                        style="-fx-background-color: #1B222D;
                               -fx-text-fill: #E6EAF0;
                               -fx-background-radius: 12;
                               -fx-border-color: #343D49;
                               -fx-border-width: 1.5;
                               -fx-border-radius: 12;
                               -fx-cursor: hand;"
                        text="Quit">
                    <font>
                        <Font name="DejaVu Sans Mono Bold" size="20.0" />
                    </font>
                </Button>
            </children>

            <BorderPane.margin>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </BorderPane.margin>
        </VBox>
    </left>

    <center>
        <ImageView fitHeight="530.0"
                   fitWidth="536.0"
                   pickOnBounds="true"
                   preserveRatio="true"
                   BorderPane.alignment="CENTER">
            <image>
                <Image url="@images/background.png" />
            </image>

            <BorderPane.margin>
                <Insets right="10.0" />
            </BorderPane.margin>
        </ImageView>
    </center>

</BorderPane>