<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="650.0"
            prefWidth="900.0"
            style="-fx-background-color: #070B12;"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.robomaze.controllers.HowToPlayController">

    <left>
        <VBox alignment="CENTER"
              prefHeight="650.0"
              prefWidth="303.0"
              spacing="20.0"
              style="-fx-background-color: #111720;
                     -fx-background-radius: 18;
                     -fx-border-color: #343D49;
                     -fx-border-width: 2;
                     -fx-border-radius: 18;
                     -fx-padding: 20;"
              BorderPane.alignment="CENTER">
            <children>
                <VBox alignment="CENTER"
                      prefHeight="108.0"
                      prefWidth="303.0">
                    <children>
                        <Label prefHeight="58.0"
                               prefWidth="140.0"
                               style="-fx-text-fill: #E6EAF0;"
                               text="ROBOT"
                               wrapText="true">
                            <font>
                                <Font name="Consolas Bold Italic" size="50.0" />
                            </font>
                        </Label>

                        <Label prefHeight="58.0"
                               prefWidth="110.0"
                               style="-fx-text-fill: #E6EAF0;"
                               text="MAZE">
                            <font>
                                <Font name="Consolas Bold Italic" size="50.0" />
                            </font>
                        </Label>
                    </children>
                </VBox>

                <Button fx:id="btnPlay"
                        mnemonicParsing="false"
                        prefHeight="42.0"
                        prefWidth="194.0"
                        style="-fx-background-color: #1B222D;
                               -fx-text-fill: #E6EAF0;
                               -fx-background-radius: 12;
                               -fx-border-color: #343D49;
                               -fx-border-width: 1.5;
                               -fx-border-radius: 12;
                               -fx-cursor: hand;"
                        text="PLAY">
                    <font>
                        <Font name="Consolas Bold" size="20.0" />
                    </font>
                </Button>

                <Button fx:id="btnHTP"
                        mnemonicParsing="false"
                        prefHeight="42.0"
                        prefWidth="194.0"
                        style="-fx-background-color: #E6EAF0;
                               -fx-text-fill: #1B222D;
                               -fx-background-radius: 12;
                               -fx-border-color: #343D49;
                               -fx-border-width: 1.5;
                               -fx-border-radius: 12;
                               -fx-cursor: hand;"
                        text="How to Play">
                    <font>
                        <Font name="Consolas Bold" size="20.0" />
                    </font>
                </Button>

                <Button fx:id="btnQuit"
                        mnemonicParsing="false"
                        prefHeight="42.0"
                        prefWidth="194.0"
                        style="-fx-background-color: #1B222D;
                               -fx-text-fill: #E6EAF0;
                               -fx-background-radius: 12;
                               -fx-border-color: #343D49;
                               -fx-border-width: 1.5;
                               -fx-border-radius: 12;
                               -fx-cursor: hand;"
                        text="Quit">
                    <font>
                        <Font name="Consolas Bold" size="20.0" />
                    </font>
                </Button>
            </children>

            <BorderPane.margin>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </BorderPane.margin>
        </VBox>
    </left>

    <center>
        <VBox spacing="14.0"
              style="-fx-padding: 18 20 18 0;">
            <children>
                <VBox alignment="CENTER"
                      spacing="4.0">
                    <children>
                        <Label style="-fx-text-fill: #E6EAF0;"
                               text="HOW TO PLAY">
                            <font>
                                <Font name="Consolas Bold Italic" size="42.0" />
                            </font>
                        </Label>

                        <Label style="-fx-text-fill: #999999;"
                               text="Program the robot. Find the route. Reach the goal.">
                            <font>
                                <Font name="Consolas" size="12.0" />
                            </font>
                        </Label>
                    </children>
                </VBox>

                <ScrollPane fitToWidth="true"
                            hbarPolicy="NEVER"
                            style="-fx-background: transparent;
                                   -fx-background-color: transparent;
                                   -fx-border-color: transparent;">
                    <content>
                        <VBox spacing="12.0"
                              style="-fx-background-color: transparent;">
                            <padding>
                                <Insets bottom="6.0" left="2.0" right="8.0" top="2.0" />
                            </padding>

                            <children>
                                <VBox spacing="10.0"
                                      style="-fx-background-color: #111720;
                                             -fx-background-radius: 18;
                                             -fx-border-color: #343D49;
                                             -fx-border-width: 1.5;
                                             -fx-border-radius: 18;
                                             -fx-padding: 16;">
                                    <children>
                                        <HBox alignment="CENTER_LEFT"
                                              spacing="12.0">
                                            <children>
                                                <Circle fill="#1B222D" radius="20.0" />

                                                <VBox spacing="4.0">
                                                    <children>
                                                        <Label style="-fx-text-fill: #E6EAF0;"
                                                               text="1. THE OBJECTIVE">
                                                            <font>
                                                                <Font name="Consolas Bold" size="18.0" />
                                                            </font>
                                                        </Label>

                                                        <Label style="-fx-text-fill: #DDDDDD;"
                                                               text="Guide your robot through the maze and reach the green target. Walls block your path, so plan your route before running your program."
                                                               wrapText="true">
                                                            <font>
                                                                <Font name="Consolas" size="12.0" />
                                                            </font>
                                                        </Label>
                                                    </children>
                                                </VBox>
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>

                                <VBox spacing="10.0"
                                      style="-fx-background-color: #111720;
                                             -fx-background-radius: 18;
                                             -fx-border-color: #343D49;
                                             -fx-border-width: 1.5;
                                             -fx-border-radius: 18;
                                             -fx-padding: 16;">
                                    <children>
                                        <HBox alignment="CENTER_LEFT"
                                              spacing="12.0">
                                            <children>
                                                <Circle fill="#1B222D" radius="20.0" />

                                                <VBox spacing="4.0">
                                                    <children>
                                                        <Label style="-fx-text-fill: #E6EAF0;"
                                                               text="2. BUILD YOUR PROGRAM">
                                                            <font>
                                                                <Font name="Consolas Bold" size="18.0" />
                                                            </font>
                                                        </Label>

                                                        <Label style="-fx-text-fill: #E6EAF0;"
                                                               text="Use the command buttons to add instructions to your program. Commands run in the order you add them."
                                                               wrapText="true">
                                                            <font>
                                                                <Font name="Consolas" size="12.0" />
                                                            </font>
                                                        </Label>
                                                    </children>
                                                </VBox>
                                            </children>
                                        </HBox>

                                        <HBox spacing="10.0">
                                            <children>
                                                <VBox alignment="CENTER"
                                                      spacing="5.0"
                                                      style="-fx-background-color: #343D49;
                                                             -fx-background-radius: 10;
                                                             -fx-padding: 10;"
                                                      HBox.hgrow="ALWAYS">
                                                    <children>
                                                        <Label style="-fx-text-fill: #E6EAF0;"
                                                               text="↑">
                                                            <font>
                                                                <Font name="Consolas Bold" size="22.0" />
                                                            </font>
                                                        </Label>

                                                        <Label style="-fx-text-fill: #E6EAF0;"
                                                               text="FORWARD">
                                                            <font>
                                                                <Font name="Consolas Bold" size="14.0" />
                                                            </font>
                                                        </Label>

                                                        <Label style="-fx-text-fill: #AAAAAA;"
                                                               text="Move one tile">
                                                            <font>
                                                                <Font name="Consolas" size="12.0" />
                                                            </font>
                                                        </Label>
                                                    </children>
                                                </VBox>

                                                <VBox alignment="CENTER"
                                                      spacing="5.0"
                                                      style="-fx-background-color: #343D49;
                                                             -fx-background-radius: 10;
                                                             -fx-padding: 10;"
                                                      HBox.hgrow="ALWAYS">
                                                    <children>
                                                        <Label style="-fx-text-fill: #E6EAF0;"
                                                               text="↶">
                                                            <font>
                                                                <Font name="Consolas Bold" size="22.0" />
                                                            </font>
                                                        </Label>

                                                        <Label style="-fx-text-fill: #E6EAF0;"
                                                               text="TURN LEFT">
                                                            <font>
                                                                <Font name="Consolas Bold" size="14.0" />
                                                            </font>
                                                        </Label>

                                                        <Label style="-fx-text-fill: #AAAAAA;"
                                                               text="Rotate left">
                                                            <font>
                                                                <Font name="Consolas" size="12.0" />
                                                            </font>
                                                        </Label>
                                                    </children>
                                                </VBox>

                                                <VBox alignment="CENTER"
                                                      spacing="5.0"
                                                      style="-fx-background-color: #343D49;
                                                             -fx-background-radius: 10;
                                                             -fx-padding: 10;"
                                                      HBox.hgrow="ALWAYS">
                                                    <children>
                                                        <Label style="-fx-text-fill: #E6EAF0;"
                                                               text="↷">
                                                            <font>
                                                                <Font name="Consolas Bold" size="22.0" />
                                                            </font>
                                                        </Label>

                                                        <Label style="-fx-text-fill: #E6EAF0;"
                                                               text="TURN RIGHT">
                                                            <font>
                                                                <Font name="Consolas Bold" size="14.0" />
                                                            </font>
                                                        </Label>

                                                        <Label style="-fx-text-fill: #AAAAAA;"
                                                               text="Rotate right">
                                                            <font>
                                                                <Font name="Consolas" size="12.0" />
                                                            </font>
                                                        </Label>
                                                    </children>
                                                </VBox>
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>

                                <VBox spacing="10.0"
                                      style="-fx-background-color: #111720;
                                             -fx-background-radius: 18;
                                             -fx-border-color: #343D49;
                                             -fx-border-width: 1.5;
                                             -fx-border-radius: 18;
                                             -fx-padding: 16;">
                                    <children>
                                        <HBox alignment="CENTER_LEFT"
                                              spacing="12.0">
                                            <children>
                                                <Circle fill="#1B222D" radius="20.0" />

                                                <VBox spacing="4.0">
                                                    <children>
                                                        <Label style="-fx-text-fill: #E6EAF0;"
                                                               text="3. RUN &amp; RESET">
                                                            <font>
                                                                <Font name="Consolas Bold" size="18.0" />
                                                            </font>
                                                        </Label>

                                                        <Label style="-fx-text-fill: #E6EAF0;"
                                                               text="Press RUN to execute the commands. Use Clear Commands to empty your program, or Reset to return the robot and move counter to their starting state."
                                                               wrapText="true">
                                                            <font>
                                                                <Font name="Consolas" size="12.0" />
                                                            </font>
                                                        </Label>
                                                    </children>
                                                </VBox>
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>

                                <VBox spacing="10.0"
                                      style="-fx-background-color: #111720;
                                             -fx-background-radius: 18;
                                             -fx-border-color: #343D49;
                                             -fx-border-width: 1.5;
                                             -fx-border-radius: 18;
                                             -fx-padding: 16;">
                                    <children>
                                        <HBox alignment="CENTER_LEFT"
                                              spacing="12.0">
                                            <children>
                                                <Circle fill="#1b222d" radius="20.0" />

                                                <VBox spacing="4.0">
                                                    <children>
                                                        <Label style="-fx-text-fill: #E6EAF0;"
                                                               text="4. WATCH YOUR MOVES">
                                                            <font>
                                                                <Font name="Consolas Bold" size="18.0" />
                                                            </font>
                                                        </Label>

                                                        <Label style="-fx-text-fill: #E6EAF0;"
                                                               text="The robot cannot move through walls or leave the maze. Invalid moves should not count. Reach the green target to complete the level."
                                                               wrapText="true">
                                                            <font>
                                                                <Font name="Consolas" size="12.0" />
                                                            </font>
                                                        </Label>
                                                    </children>
                                                </VBox>
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>

                                <Label style="-fx-text-fill: #8F8F8F;
                                              -fx-font-style: italic;"
                                       text="TIP: The shortest route is not always the route your first idea takes!"
                                       wrapText="true">
                                    <font>
                                        <Font name="Consolas" size="12.0" />
                                    </font>

                                    <VBox.margin>
                                        <Insets bottom="4.0" left="8.0" right="8.0" top="2.0" />
                                    </VBox.margin>
                                </Label>
                            </children>
                        </VBox>
                    </content>
                </ScrollPane>
            </children>
        </VBox>
    </center>

</BorderPane>