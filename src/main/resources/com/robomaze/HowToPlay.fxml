<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="650.0" prefWidth="900.0" style="-fx-background-color: #000000;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.robomaze.controllers.HowToPlayController">

    <left>
        <VBox alignment="CENTER" prefHeight="650.0" prefWidth="303.0" spacing="20.0" style="-fx-background-color: #151515;                      -fx-background-radius: 18;                      -fx-border-color: #777777;                      -fx-border-width: 2;                      -fx-border-radius: 18;                      -fx-padding: 20;" BorderPane.alignment="CENTER">
            <children>
                <VBox alignment="CENTER" prefHeight="108.0" prefWidth="303.0">
                    <children>
                        <Label prefHeight="57.0" prefWidth="133.0" style="-fx-text-fill: white;" text="ROBOT">
                            <font>
                                <Font name="System Bold Italic" size="40.0" />
                            </font>
                        </Label>

                        <Label prefHeight="52.0" prefWidth="102.0" style="-fx-text-fill: white;" text="MAZE">
                            <font>
                                <Font name="System Bold Italic" size="36.0" />
                            </font>
                        </Label>
                    </children>
                </VBox>

                <Button fx:id="btnPlay" mnemonicParsing="false" onAction="#switchToGame" prefHeight="42.0" prefWidth="194.0" style="-fx-background-color: #292929;                                -fx-text-fill: white;                                -fx-background-radius: 12;                                -fx-border-color: #888888;                                -fx-border-width: 1.5;                                -fx-border-radius: 12;                                -fx-cursor: hand;" text="Play" />

                <Button fx:id="btnHTP" disable="true" mnemonicParsing="false" prefHeight="42.0" prefWidth="194.0" style="-fx-background-color: #292929;                                -fx-text-fill: white;                                -fx-background-radius: 12;                                -fx-border-color: #888888;                                -fx-border-width: 1.5;                                -fx-border-radius: 12;                                -fx-cursor: hand;" text="How to Play" />

                <Button fx:id="btnQuit" mnemonicParsing="false" prefHeight="42.0" prefWidth="194.0" style="-fx-background-color: #292929;                                -fx-text-fill: white;                                -fx-background-radius: 12;                                -fx-border-color: #888888;                                -fx-border-width: 1.5;                                -fx-border-radius: 12;                                -fx-cursor: hand;" text="Quit" />

            </children>
            <BorderPane.margin>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </BorderPane.margin>
        </VBox>
    </left>
   <center>
      <VBox prefHeight="200.0" prefWidth="722.0" spacing="20.0" BorderPane.alignment="CENTER">
         <children>
            <VBox alignment="CENTER" prefHeight="108.0" prefWidth="557.0">
               <children>
                  <Label prefHeight="57.0" prefWidth="264.0" style="-fx-text-fill: white;" text="HOW TO PLAY">
                     <font>
                        <Font name="System Bold Italic" size="40.0" />
                     </font>
                  </Label>
                  <VBox alignment="CENTER_LEFT" prefHeight="650.0" prefWidth="303.0" spacing="20.0" style="-fx-background-color: #151515;                      -fx-background-radius: 18;                      -fx-border-color: #777777;                      -fx-border-width: 2;                      -fx-border-radius: 18;                      -fx-padding: 20;">
                     <children>
                        <HBox prefHeight="100.0" prefWidth="200.0">
                           <children>
                              <Circle fill="#434343" radius="27.0" stroke="BLACK" strokeType="INSIDE" />
                              <VBox prefHeight="54.0" prefWidth="464.0">
                                 <children>
                                    <Label text="THE OBJECTIVE" textFill="WHITE">
                                       <font>
                                          <Font name="System Bold" size="18.0" />
                                       </font>
                                    </Label>
                                    <Label text="Guide your robot through the maze and reach the" textFill="WHITE">
                                       <font>
                                          <Font size="14.0" />
                                       </font>
                                    </Label>
                                    <Label text="goal square using the fastest path." textFill="WHITE">
                                       <font>
                                          <Font size="14.0" />
                                       </font>
                                    </Label>
                                    <Label />
                                    <Label text="Plan the route before running the program!" textFill="#6f6f6f" />
                                 </children>
                                 <HBox.margin>
                                    <Insets left="10.0" />
                                 </HBox.margin>
                              </VBox>
                           </children>
                        </HBox>
                     </children>
                  </VBox>
               </children>
            </VBox>
            <VBox alignment="CENTER" prefHeight="108.0" prefWidth="557.0">
               <children>
                  <VBox alignment="CENTER_LEFT" prefHeight="650.0" prefWidth="303.0" spacing="20.0" style="-fx-background-color: #151515;                      -fx-background-radius: 18;                      -fx-border-color: #777777;                      -fx-border-width: 2;                      -fx-border-radius: 18;                      -fx-padding: 20;">
                     <children>
                        <HBox prefHeight="100.0" prefWidth="200.0">
                           <children>
                              <Circle fill="#434343" radius="27.0" stroke="BLACK" strokeType="INSIDE" />
                              <VBox prefHeight="54.0" prefWidth="464.0">
                                 <children>
                                    <Label text="BUILD YOUR PROGRAM" textFill="WHITE">
                                       <font>
                                          <Font name="System Bold" size="18.0" />
                                       </font>
                                    </Label>
                                    <Label text="Add commands in the order you want the robot to execute them." textFill="WHITE">
                                       <font>
                                          <Font size="14.0" />
                                       </font>
                                    </Label>
                                    <Label />
                                    <HBox prefHeight="100.0" prefWidth="200.0">
                                       <children>
                                          <VBox alignment="CENTER_LEFT" prefHeight="122.0" prefWidth="353.0" spacing="20.0" style="-fx-background-color: #151515;                      -fx-background-radius: 18;                      -fx-border-color: #777777;                      -fx-border-width: 2;                      -fx-border-radius: 18;                      -fx-padding: 20;">
                                             <children>
                                                <HBox prefHeight="100.0" prefWidth="200.0">
                                                   <children>
                                                      <Circle fill="#434343" radius="36.0" stroke="BLACK" strokeType="INSIDE" />
                                                      <VBox alignment="CENTER_LEFT" prefHeight="54.0" prefWidth="464.0">
                                                         <children>
                                                            <Label text="Forward" textFill="WHITE">
                                                               <font>
                                                                  <Font name="System Bold" size="14.0" />
                                                               </font>
                                                            </Label>
                                                            <Label text="Move one tile in the direction" textFill="WHITE">
                                                               <font>
                                                                  <Font size="14.0" />
                                                               </font>
                                                            </Label>
                                                            <Label text="you are facing." textFill="WHITE">
                                                               <font>
                                                                  <Font size="14.0" />
                                                               </font>
                                                            </Label>
                                                            <Label />
                                                         </children>
                                                         <HBox.margin>
                                                            <Insets left="10.0" />
                                                         </HBox.margin>
                                                      </VBox>
                                                   </children>
                                                </HBox>
                                             </children>
                                          </VBox>
                                       </children>
                                    </HBox>
                                 </children>
                                 <HBox.margin>
                                    <Insets left="10.0" />
                                 </HBox.margin>
                              </VBox>
                           </children>
                        </HBox>
                     </children>
                  </VBox>
               </children>
            </VBox>
         </children>
         <BorderPane.margin>
            <Insets right="20.0" top="10.0" />
         </BorderPane.margin>
      </VBox>
   </center>



</BorderPane>
